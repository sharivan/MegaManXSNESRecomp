<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Keep the legacy Visual Studio/MSVC harness aligned with runner.cmake.
    Directory.Build.targets is imported after the .vcxproj, so it can repair
    stale item paths without duplicating the entire project file.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='mmx'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)snesrecomp\runner\src\desktop;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>$(SolutionDir)src\msvc_host_compat.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions>SNESRECOMP_POST_MORTEM_TIER2=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)'=='mmx'">
    <!-- These used to live beside mmx.vcxproj; they are framework-owned now. -->
    <ClCompile Remove="glsl_shader.c" />
    <ClCompile Remove="$(ProjectDir)glsl_shader.c" />
    <ClCompile Remove="post_mortem.c" />
    <ClCompile Remove="$(ProjectDir)post_mortem.c" />
    <ClInclude Remove="glsl_shader.h" />
    <ClInclude Remove="$(ProjectDir)glsl_shader.h" />

    <!-- Mirror snesrecomp_target_{mmx_config,glsl_shader,post_mortem,fiber_compat}. -->
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\desktop\mmx_config.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\desktop\glsl_shader.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\desktop\post_mortem.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\desktop\fiber_compat.c" />
    <ClInclude Include="$(SolutionDir)snesrecomp\runner\src\desktop\glsl_shader.h" />
    <ClInclude Include="$(SolutionDir)snesrecomp\runner\src\desktop\post_mortem.h" />
    <ClInclude Include="$(SolutionDir)snesrecomp\runner\src\desktop\fiber_compat.h" />

    <!-- runner.cmake gained these after the original .vcxproj source list was
         authored. Keep the MSVC harness on the same hardware/runtime set. -->
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\launcher_cache.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\launcher_picker.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\rom_image_verify.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\dsp1.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\dsp1_hle.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\joypad.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\sa1.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\tier2_capture.c" />
    <ClCompile Include="$(SolutionDir)snesrecomp\runner\src\snes\cx4.c" />

    <!-- The game has a local src/recomp_launcher.h wrapper.  The flattened
         legacy MSVC project also compiles recomp-ui's own C sources, and its
         launcher_ng_capi.c must resolve "recomp_launcher.h" to recomp-ui's
         public ABI header rather than the game wrapper.  CMake naturally keeps
         these target include scopes separate; reproduce that isolation here. -->
    <ClCompile Update="..\recomp-ui\src\common\launcher_ng_capi.c">
      <AdditionalIncludeDirectories>$(SolutionDir)recomp-ui\src;$(SolutionDir)recomp-ui\src\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>

    <!-- v2_emit deliberately materializes labels for every proven guest-PC
         entry point.  Many are not the target of a C goto in a particular
         emitted variant, so MSVC reports thousands of benign C4102 warnings.
         Silence that diagnostic only for ROM-derived generated C; keep the
         warning enabled for handwritten/framework code. -->
    <ClCompile Update="gen\*.c">
      <DisableSpecificWarnings>4102;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemGroup>

  <!-- src/gen is intentionally ROM-derived and gitignored. Fail with an
       actionable message instead of a cascade of C1083 errors. -->
  <Target Name="EnsureMmxGeneratedSources"
          BeforeTargets="ClCompile"
          Condition="'$(MSBuildProjectName)'=='mmx'">
    <Error Condition="!Exists('$(ProjectDir)gen\dispatch_v2.c') Or !Exists('$(ProjectDir)gen\unresolved_stubs_v2.c')"
           Text="Mega Man X generated sources are missing. From PowerShell run: powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\tools\regen.ps1 usa -NoTests [-RomPath path\to\rom.smc]" />
  </Target>
</Project>
